# Local demo works without an odds API key, PostgreSQL, Redis, or SMTP.
APP_ENV=development
DATA_MODE=demo
OWNER_USERNAME=daniel
OWNER_PASSWORD=evhunter-demo-2026
SESSION_SECRET=local-demo-secret-change-before-deploy-2026
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EMBED_WORKER=true
# Omit DATABASE_URL for the local SQLite default. Production requires PostgreSQL.
# DATABASE_URL=postgresql://evhunter:password@localhost:5432/evhunter
# REDIS_URL=redis://localhost:6379/0
BACKEND_URL=http://127.0.0.1:8000
ODDS_API_KEY=
SPORTS=basketball_nba,americanfootball_nfl
BOOKMAKERS=fanduel,fanatics,draftkings
POLL_SECONDS=60
PREDICTION_POLL_SECONDS=20
# Optional direct streams: kalshi,polymarket_us,polymarket,novig
# Keep blank until credentials, access rights, and reviewed mappings are ready.
PREDICTION_STREAMS=
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
POLYMARKET_US_KEY_ID=
POLYMARKET_US_SECRET_KEY=
NOVIG_KEY_ID=
NOVIG_PRIVATE_KEY_PATH=
MONTHLY_CREDIT_BUDGET=4500000
# After reviewing current operator settlement rules, list approved feed books.
REVIEWED_BOOKS=
# Explicit current exchange fee review. Never assume these venues are fee-free.
EXCHANGE_FEE_CONFIG={}
# Example ONLY after your review: {"novig":{"model":"profit","rate":0,"reviewed_at":"YYYY-MM-DD"}}
HISTORY_RETENTION_DAYS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
